# SocialMapper API Configuration
# Copy this file to .env and update with your values

# API Server Configuration
SOCIALMAPPER_API_HOST=0.0.0.0
SOCIALMAPPER_API_PORT=8000
SOCIALMAPPER_API_API_TITLE=SocialMapper API
SOCIALMAPPER_API_API_VERSION=0.2.0
SOCIALMAPPER_API_DEBUG_MODE=false
SOCIALMAPPER_API_LOG_LEVEL=INFO

# CORS Configuration
SOCIALMAPPER_API_CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501

# Job Processing
SOCIALMAPPER_API_MAX_CONCURRENT_JOBS=20
SOCIALMAPPER_API_RESULT_TTL_HOURS=24
SOCIALMAPPER_API_CLEANUP_INTERVAL_MINUTES=60

# Rate Limiting
SOCIALMAPPER_API_RATE_LIMIT_PER_MINUTE=60

# API Authentication
SOCIALMAPPER_API_API_AUTH_ENABLED=false
SOCIALMAPPER_API_API_KEYS=

# Storage
SOCIALMAPPER_API_RESULT_STORAGE_PATH=./results

# External APIs
SOCIALMAPPER_API_CENSUS_API_KEY=
SOCIALMAPPER_API_OSM_API_TIMEOUT=30
SOCIALMAPPER_API_CENSUS_API_TIMEOUT=30

# Redis Cache Configuration
SOCIALMAPPER_API_REDIS_HOST=localhost
SOCIALMAPPER_API_REDIS_PORT=6379
SOCIALMAPPER_API_REDIS_DB=0
SOCIALMAPPER_API_REDIS_PASSWORD=
SOCIALMAPPER_API_CACHE_ENABLED=true

# PostgreSQL Database Configuration
SOCIALMAPPER_API_DATABASE_URL=postgresql://postgres:socialmapper_secret@localhost:5432/socialmapper
SOCIALMAPPER_API_DB_HOST=localhost
SOCIALMAPPER_API_DB_PORT=5432
SOCIALMAPPER_API_DB_NAME=socialmapper
SOCIALMAPPER_API_DB_USER=postgres
SOCIALMAPPER_API_DB_PASSWORD=socialmapper_secret
SOCIALMAPPER_API_DB_POOL_MIN_SIZE=10
SOCIALMAPPER_API_DB_POOL_MAX_SIZE=50

# WebSocket Configuration
SOCIALMAPPER_API_WEBSOCKET_ENABLED=true
SOCIALMAPPER_API_WEBSOCKET_HEARTBEAT_INTERVAL=30

# Performance Optimization
SOCIALMAPPER_API_ENABLE_RESPONSE_COMPRESSION=true
SOCIALMAPPER_API_PAGINATION_DEFAULT_LIMIT=100
SOCIALMAPPER_API_PAGINATION_MAX_LIMIT=1000

# Demo Platform Configuration
SOCIALMAPPER_API_DEMO_MODE_ENABLED=false
SOCIALMAPPER_API_DEMO_MAX_CONCURRENT_JOBS=3
SOCIALMAPPER_API_DEMO_SESSION_TIMEOUT_MINUTES=60

# Analysis Configuration
SOCIALMAPPER_API_DEFAULT_TRAVEL_TIME_MINUTES=15
SOCIALMAPPER_API_MAX_TRAVEL_TIME_MINUTES=60
SOCIALMAPPER_API_MAX_POI_TYPES_PER_REQUEST=10
SOCIALMAPPER_API_MAX_CENSUS_VARIABLES_PER_REQUEST=20

# ===========================
# MCP (Model Context Protocol) Configuration
# ===========================

# Enable MCP integration for AI assistant interactions
SOCIALMAPPER_API_MCP_ENABLED=true

# MCP server mount path (where MCP endpoints will be available)
SOCIALMAPPER_API_MCP_MOUNT_PATH=/mcp

# MCP authentication settings
SOCIALMAPPER_API_MCP_AUTH_ENABLED=false  # Set to true to require authentication for MCP endpoints
SOCIALMAPPER_API_MCP_AUTH_TOKEN=  # Authentication token for MCP (required if auth is enabled)

# MCP rate limiting (requests per minute per client)
SOCIALMAPPER_API_MCP_RATE_LIMIT_PER_MINUTE=100

# MCP tool configuration
SOCIALMAPPER_API_MCP_ALLOWED_TOOLS=  # Comma-separated list of allowed tools (empty = all tools)
SOCIALMAPPER_API_MCP_TOOL_TIMEOUT=30  # Timeout for tool invocations in seconds
SOCIALMAPPER_API_MCP_MAX_CONCURRENT=10  # Maximum concurrent tool invocations

# MCP context middleware settings
SOCIALMAPPER_API_MCP_ENABLE_PERFORMANCE_LOGGING=true  # Log performance metrics for MCP requests
SOCIALMAPPER_API_MCP_ENABLE_REQUEST_LOGGING=true  # Log MCP requests and responses
SOCIALMAPPER_API_MCP_PERFORMANCE_THRESHOLD_MS=1000  # Threshold for slow request warnings (milliseconds)

# MCP metrics collection
SOCIALMAPPER_API_MCP_METRICS_ENABLED=true  # Enable detailed MCP metrics collection
SOCIALMAPPER_API_MCP_METRICS_RETENTION_HOURS=24  # How long to retain detailed metrics
SOCIALMAPPER_API_MCP_METRICS_DETAILED_TRACKING=true  # Enable detailed per-invocation tracking