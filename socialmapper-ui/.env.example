# SocialMapper UI Environment Variables

# API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_TITLE=SocialMapper
VITE_APP_VERSION=1.0.0

# Mapbox Configuration (required for map functionality)
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Feature Flags
VITE_ENABLE_DEMO_SCENARIOS=true
VITE_ENABLE_CUSTOM_POI=true
VITE_ENABLE_BATCH_ANALYSIS=false

# Development
VITE_ENABLE_DEVTOOLS=true
VITE_LOG_LEVEL=info