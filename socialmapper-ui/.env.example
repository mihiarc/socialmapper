# SocialMapper UI Configuration
# Copy this file to .env and update the values as needed

# API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_KEY=
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# Feature Flags
VITE_ENABLE_CUSTOM_POIS=true
VITE_ENABLE_BATCH_ANALYSIS=true
VITE_ENABLE_ADVANCED_FILTERS=false
VITE_ENABLE_EXPERIMENTAL=false

# Map Configuration
VITE_MAP_CENTER_LAT=40.7128
VITE_MAP_CENTER_LNG=-74.0060
VITE_MAP_DEFAULT_ZOOM=10
VITE_MAP_MIN_ZOOM=3
VITE_MAP_MAX_ZOOM=18
VITE_MAP_TILE_PROVIDER=openstreetmap
# VITE_MAPBOX_TOKEN=your_mapbox_token_here

# UI Configuration
VITE_UI_THEME=system
VITE_UI_DATE_FORMAT=MM/DD/YYYY
VITE_UI_NUMBER_FORMAT=en-US
VITE_UI_MAX_TOAST_MESSAGES=5
VITE_UI_TOAST_DURATION=5000

# Analysis Configuration
VITE_ANALYSIS_DEFAULT_TRAVEL_TIME=15
VITE_ANALYSIS_MAX_TRAVEL_TIME=60
VITE_ANALYSIS_DEFAULT_TRAVEL_MODE=walk
VITE_ANALYSIS_POLLING_INTERVAL=2000
VITE_ANALYSIS_MAX_POLLING_ATTEMPTS=300

# Development Configuration (only used in development builds)
VITE_DEV_ENABLE_DEVTOOLS=true
VITE_DEV_ENABLE_LOGGING=true
VITE_DEV_LOG_LEVEL=info
VITE_DEV_MOCK_API=false