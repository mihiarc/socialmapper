# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and customize for your environment

# Basic Configuration
aws_region      = "us-east-1"
environment     = "production"
cluster_name    = "socialmapper"
cluster_version = "1.28"

# Domain and SSL
domain_name = "demo.socialmapper.com"
# cert_arn = "arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"

# Network Configuration
vpc_cidr        = "10.0.0.0/16"
private_subnets = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
public_subnets  = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

# EKS Node Groups Configuration
node_groups = {
  main = {
    instance_types = ["t3.medium", "t3.large"]
    capacity_type  = "SPOT"          # Use SPOT instances for cost savings
    min_size       = 2
    max_size       = 10
    desired_size   = 3
    disk_size      = 50
  }
  compute_intensive = {
    instance_types = ["c5.xlarge", "c5.2xlarge"]
    capacity_type  = "SPOT"
    min_size       = 0               # Scale to zero when not needed
    max_size       = 5
    desired_size   = 0
    disk_size      = 100
  }
}

# Database Configuration
rds_instance_class      = "db.t3.micro"    # Start small, can scale up
rds_allocated_storage   = 20               # GB
backup_retention_days   = 7
enable_deletion_protection = false         # Set to true for production

# Redis Configuration
redis_node_type        = "cache.t3.micro"  # Start small
redis_num_cache_nodes  = 1                 # Single node for demo

# Feature Flags
enable_monitoring = true
enable_logging    = true

# Security Configuration
allowed_cidr_blocks = [
  "0.0.0.0/0"  # CAUTION: This allows access from anywhere
               # In production, restrict this to specific IP ranges
]

# Additional Tags
tags = {
  Owner       = "DevOps Team"
  Project     = "SocialMapper"
  Environment = "Production"
  CostCenter  = "Engineering"
}