# Placeholder UI Dockerfile
# This is a temporary placeholder until the actual UI is implemented

FROM nginx:1.25-alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Create a simple static page
RUN echo '<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SocialMapper Demo - Coming Soon</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: white;
        }
        .container {
            text-align: center;
            max-width: 600px;
            padding: 2rem;
        }
        .logo {
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 1rem;
        }
        .subtitle {
            font-size: 1.2rem;
            margin-bottom: 2rem;
            opacity: 0.9;
        }
        .status {
            background: rgba(255, 255, 255, 0.2);
            padding: 1rem;
            border-radius: 8px;
            margin: 2rem 0;
        }
        .api-link {
            color: #FFD700;
            text-decoration: none;
            font-weight: bold;
        }
        .api-link:hover {
            text-decoration: underline;
        }
        .features {
            text-align: left;
            margin: 2rem 0;
        }
        .features ul {
            list-style: none;
            padding: 0;
        }
        .features li {
            padding: 0.5rem 0;
            position: relative;
            padding-left: 2rem;
        }
        .features li:before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #4CAF50;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">🗺️ SocialMapper</div>
        <div class="subtitle">Point of Interest Accessibility Analysis Platform</div>
        
        <div class="status">
            <h3>🚧 Demo Platform Status</h3>
            <p>The web interface is currently under development.</p>
            <p>The API is fully functional and ready for testing!</p>
            <p><a href="/api/v1/health" class="api-link">API Health Check</a> | 
               <a href="/api/docs" class="api-link">API Documentation</a></p>
        </div>

        <div class="features">
            <h3>🌟 Available Features</h3>
            <ul>
                <li>Census demographic data integration</li>
                <li>Point of Interest (POI) discovery and analysis</li>
                <li>Travel time and accessibility calculations</li>
                <li>Geospatial analysis and mapping</li>
                <li>RESTful API with comprehensive endpoints</li>
                <li>Auto-scaling production infrastructure</li>
                <li>Real-time monitoring and alerting</li>
            </ul>
        </div>

        <div class="status">
            <h3>🔧 For Developers</h3>
            <p>Try the API endpoints:</p>
            <ul style="text-align: left; max-width: 400px; margin: 0 auto;">
                <li><code>GET /api/v1/metadata/census-variables</code></li>
                <li><code>GET /api/v1/metadata/travel-modes</code></li>
                <li><code>POST /api/v1/analysis/demographic</code></li>
                <li><code>POST /api/v1/analysis/poi-discovery</code></li>
            </ul>
        </div>

        <div style="margin-top: 2rem; font-size: 0.9rem; opacity: 0.7;">
            <p>Infrastructure deployed with Kubernetes on AWS EKS</p>
            <p>Monitored with Prometheus & Grafana</p>
            <p id="timestamp"></p>
        </div>
    </div>

    <script>
        // Show current timestamp
        document.getElementById("timestamp").textContent = "Last updated: " + new Date().toISOString();
        
        // Simple health check indicator
        fetch("/api/v1/health")
            .then(response => response.json())
            .then(data => {
                if (data.status === "healthy") {
                    document.querySelector(".status").style.borderLeft = "4px solid #4CAF50";
                }
            })
            .catch(error => {
                document.querySelector(".status").style.borderLeft = "4px solid #ff6b6b";
            });
    </script>
</body>
</html>' > /usr/share/nginx/html/index.html

# Create a health check endpoint
RUN echo 'server {
    listen 8080;
    server_name _;
    
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        
        # Add security headers
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer-when-downgrade" always;
        add_header Content-Security-Policy "default-src '\''self'\'' http: https: data: blob: '\''unsafe-inline'\''" always;
    }
    
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
    
    location /api/ {
        # Proxy to API service
        proxy_pass http://socialmapper-api-service.socialmapper.svc.cluster.local:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Enable gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;
}' > /etc/nginx/conf.d/default.conf

# Remove default nginx config
RUN rm /etc/nginx/nginx.conf

# Custom nginx config
RUN echo 'user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    
    log_format main '\''$remote_addr - $remote_user [$time_local] "$request" '\''
                    '\''$status $body_bytes_sent "$http_referer" '\''
                    '\''"$http_user_agent" "$http_x_forwarded_for"'\'';
    
    access_log /var/log/nginx/access.log main;
    
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    
    include /etc/nginx/conf.d/*.conf;
}' > /etc/nginx/nginx.conf

# Create nginx user
RUN addgroup -g 101 -S nginx && \
    adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx

# Set proper permissions
RUN chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d/

# Switch to non-root user
USER nginx

EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["nginx", "-g", "daemon off;"]