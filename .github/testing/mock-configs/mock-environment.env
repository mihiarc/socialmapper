# Mock Environment Configuration for CI/CD Pipeline Testing
# This file contains mock values for testing pipeline functionality
# without requiring real service credentials or deployments

# GitHub Environment Variables (Auto-set in real GitHub Actions)
CI=true
GITHUB_ACTIONS=true
GITHUB_WORKSPACE=/github/workspace
GITHUB_REPOSITORY=socialmapper/socialmapper
GITHUB_REF=refs/heads/main
GITHUB_SHA=mock-sha-1234567890abcdef
GITHUB_RUN_ID=mock-run-123456789
GITHUB_RUN_NUMBER=42
GITHUB_ACTOR=pipeline-tester
GITHUB_HEAD_REF=feature/test-branch
GITHUB_BASE_REF=main
GITHUB_EVENT_NAME=push
GITHUB_TOKEN=ghp_mock_github_token_1234567890abcdef

# Runner Environment
RUNNER_OS=Linux
RUNNER_ARCH=X64
RUNNER_NAME=GitHub Actions 1
RUNNER_TEMP=/tmp
RUNNER_WORKSPACE=/github/workspace
RUNNER_TOOL_CACHE=/opt/hostedtoolcache

# AWS Configuration (Mock values for testing)
AWS_ACCESS_KEY_ID=AKIAMOCKKEY123456789
AWS_SECRET_ACCESS_KEY=mockSecretKey+abcdefghijklmnopqrstuvwxyz123456
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# Kubernetes Configuration
EKS_CLUSTER_NAME=socialmapper-test-cluster
KUBE_CONFIG_DATA=LS0tLS1CRUdJTiBDRVJUSUZJQ0FURS0tLS0t

# Application Configuration
CENSUS_API_KEY=mock_census_api_key_1234567890abcdef
VITE_MAPBOX_TOKEN=pk.mock.mapbox.token.1234567890abcdef
VITE_API_URL=https://api.test.socialmapper.com
VITE_APP_TITLE=SocialMapper Test
VITE_APP_VERSION=test-build-123

# Database Configuration (Mock)
DATABASE_URL=postgresql://testuser:testpass@localhost:5432/socialmapper_test
REDIS_URL=redis://localhost:6379/0

# Security Scanning Tokens (Mock)
SNYK_TOKEN=mock-snyk-token-1234567890abcdef
SONAR_TOKEN=mock-sonar-token-1234567890abcdef
CODECOV_TOKEN=mock-codecov-token-1234567890abcdef
NVD_API_KEY=mock-nvd-api-key-1234567890abcdef

# Notification Configuration (Mock)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/mock-webhook-token

# Performance Testing Configuration
K6_CLOUD_TOKEN=mock-k6-cloud-token-1234567890abcdef
LIGHTHOUSE_SERVER_URL=http://localhost:9001

# Docker Configuration
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Feature Flags for Testing
ENABLE_MOCK_MODE=true
SKIP_REAL_DEPLOYMENTS=true
USE_MOCK_SERVICES=true
ENABLE_DEBUG_LOGGING=true
MOCK_EXTERNAL_APIS=true

# Test-specific Configuration
TEST_TIMEOUT=300
MAX_PARALLEL_TESTS=4
TEST_RETRY_COUNT=2
PRESERVE_TEST_ARTIFACTS=true

# Mock Service URLs
MOCK_API_BASE_URL=http://localhost:8000
MOCK_UI_BASE_URL=http://localhost:3000
MOCK_MONITORING_URL=http://localhost:9090