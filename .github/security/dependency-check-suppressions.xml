<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- SocialMapper Dependency Check Suppressions -->
    
    <!-- Example suppression for false positives -->
    <suppress>
        <notes><![CDATA[
        This is a false positive - the vulnerability is in a different package with a similar name
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/example-package@.*$</packageUrl>
        <cve>CVE-2021-12345</cve>
    </suppress>
    
    <!-- Suppress test dependencies that don't affect production -->
    <suppress>
        <notes><![CDATA[
        Test dependency only - not used in production
        ]]></notes>
        <filePath regex="true">.*test.*</filePath>
        <cpe regex="true">.*</cpe>
    </suppress>
    
    <!-- Suppress vulnerabilities in development dependencies -->
    <suppress>
        <notes><![CDATA[
        Development dependency - not included in production build
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/.*\-dev@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>
    
    <!-- Suppress specific known issues that are mitigated -->
    <suppress>
        <notes><![CDATA[
        This vulnerability is mitigated by our CSP headers and input validation
        ]]></notes>
        <packageUrl>pkg:npm/react@18.2.0</packageUrl>
        <cve>CVE-2023-EXAMPLE</cve>
    </suppress>
    
    <!-- Suppress vulnerabilities in vendored/bundled code -->
    <suppress>
        <notes><![CDATA[
        Vendored code - vulnerability patched in our fork
        ]]></notes>
        <filePath regex="true">.*vendor.*</filePath>
        <cve regex="true">CVE-.*</cve>
    </suppress>
</suppressions>